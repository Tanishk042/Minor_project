# ForestEar backend image: FastAPI + dashboard + correlator.
# The edge-agent image (docker/Dockerfile.edge) adds TFLite runtime + models.
FROM python:3.12-slim

WORKDIR /app

# pinned deps (torchless: TF is only needed on the training/edge images)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir tensorflow-cpu==2.18.0 || \
    pip install --no-cache-dir tensorflow==2.18.0

COPY . .

# non-root
RUN useradd -m forestear && chown -R forestear /app
USER forestear

EXPOSE 8000
CMD ["python", "-m", "backend.main", "--host", "0.0.0.0", "--port", "8000"]

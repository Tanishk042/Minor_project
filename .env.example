# Copy to .env (gitignored) and fill in your own values.
# `make backend` and `docker compose` both read this file.
#
# Backend shared token (also settable as a real environment variable).
# FORESTEAR_TOKEN="replace-with-a-long-random-token"
#
# Telegram (leave disabled in configs/default.yaml until these are set).
# TELEGRAM_BOT_TOKEN="123456:replace-me"
# TELEGRAM_CHAT_ID="replace-me"
#
# CARTO basemap for the dashboard map. The raster URL works with Leaflet;
# the key is visible to every dashboard visitor, so restrict it in CARTO.
# If a key was ever shared or committed, REGENERATE it and add a domain/referrer
# restriction before starting the backend. See docs/security.md.
# FORESTEAR_TILE_URL="https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_KEY"
# FORESTEAR_TILE_ATTRIBUTION="&copy; OpenStreetMap &copy; CARTO"
# FORESTEAR_TILE_MAX_ZOOM=19

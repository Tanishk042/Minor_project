# Copy this file to keystore.properties and fill in your own values.
# NEVER commit keystore.properties or the .jks file. Both are gitignored.
#
# Create a keystore once (keep the file and passwords safe; losing them means
# you cannot update an installed app):
#   keytool -genkeypair -v -keystore forestear-release.jks \
#     -alias forestear -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12
#
# storeFile is resolved relative to the android/ repository root.
storeFile=forestear-release.jks
storePassword=change-me
keyAlias=forestear
keyPassword=change-me
